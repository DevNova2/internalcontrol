[Unit]
Description=Quotation Daily Vue on port 5570
After=network.target

[Service]
Type=simple
User=sdq_data_admin
WorkingDirectory=/home/sdq_data_admin/internalcontrol/quotation-daily-vue
ExecStart=/home/sdq_data_admin/internalcontrol/quotation-daily-vue/run-5570.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
